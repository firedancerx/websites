{
  "project_overview": {
    "system_definition": "KOJID is a controlled B2B trading system (not a full ERP) featuring gated onboarding, hierarchical quota verification, deposit discipline, and double-entry operational finance tracking.",
    "core_control_chains": [
      { "chain": "Tenant Activation Chain", "flow": "Applied -> Provisionary Workspace -> Tax Verification -> KYC/KYB Audit -> Active/Suspended/Rejected" },
      { "chain": "Quota Verification Chain", "flow": "Provisional Claim -> Evidence Upload -> Parent Tenant Verification -> Confirmed Quota Balance" },
      { "chain": "Trading & Settlement Chain", "flow": "Inbound PO Leg 1 -> Outbound Sales Leg 2 -> Fulfillment/QC -> Dispute Adjustment -> Settlement Cockpit" },
      { "chain": "Deposit Control Chain", "flow": "Deposit Placement -> Human Receipt Confirmation -> Utilisation Mapping -> Deposit balance before top-up" },
      { "chain": "Audit & Compliance Chain", "flow": "Double-Entry Ledger Log -> Reconciliation View -> Accounting Event Drill-Down -> Security Log" }
    ]
  },
  "external_tenant_types": [
    { "id": "actual_supplier", "name_ms": "Pembekal / Penjual Sebenar", "name_en": "Actual Seller (Physical Goods Supplier)" },
