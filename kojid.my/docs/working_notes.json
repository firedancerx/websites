    { "id": "standard_buyer", "name_ms": "Pembeli Sebenar / Standard", "name_en": "Actual Buyer (Downstream Purchaser)" },
    { "id": "buyer_with_quota", "name_ms": "Pembeli Maya / Pembeli Berkuota", "name_en": "Virtual Buyer (Quota-Gated Purchaser)" },
    { "id": "mediator", "name_ms": "Mediator / Tenant Tingkat-1", "name_en": "Mediator (1st-Tier Intermediary Tenant under SuperAdmin)" },
    { "id": "auditor", "name_ms": "Juruaudit", "name_en": "Auditor (Read-Only Compliance User)" }
