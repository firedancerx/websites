# Root .gitignore for Websites repository

# Dependencies
**/node_modules/
**/vendor/
**/.pnp
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions
**/.pnpm-store/

# Backups & Archives
**/backups/
**/Backups/
*.zip
*.tar.gz
*.bak

# Environment & Secrets (Never commit credentials)
**/.env*
!**/.env.example
*.pem
*.key

# Build outputs & caches
**/.next/
**/.vinext/
**/out/
**/dist/
**/.wrangler/
**/outputs/
**/work/
**/scratch/

# Next.js / TypeScript
**/next-env.d.ts
**/coverage/
**/.vercel/

# Runtime Logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Laravel / PHP specifics (kojid.my)
**/storage/logs/
**/storage/framework/cache/
**/storage/framework/sessions/
**/storage/framework/views/
**/storage/framework/testing/
**/bootstrap/cache/
**/tmp/
.phpunit.result.cache

# Uploads & PII media
**/public/uploads/

# OS / Editor Files
.DS_Store
Thumbs.db
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
